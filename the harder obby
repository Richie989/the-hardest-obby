<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>The Hardest Obby - 500 Levels 2D Rage Platformer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rajdhani:wght@600;700;800&display=swap');
        *{user-select:none;-webkit-user-select:none;touch-action:manipulation}
        body{background-color:#090d16;font-family:'Rajdhani',sans-serif;overflow:hidden}
        .font-pixel{font-family:'Press Start 2P',monospace}
        #game-container{position:relative;width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle,#1e1b4b 0%,#090d16 100%)}
        canvas{display:block;box-shadow:0 0 40px rgba(239,68,68,.25);border-radius:12px;background:#0b0f19;image-rendering:pixelated}
        .btn-rage{transition:all .1s ease;box-shadow:0 4px 0 #000}
        .btn-rage:active{transform:translateY(3px);box-shadow:0 1px 0 #000}
        .shake{animation:shakeAnim .25s cubic-bezier(.36,.07,.19,.97) both}
        @keyframes shakeAnim{10%,90%{transform:translate3d(-3px,0,0)}20%,80%{transform:translate3d(5px,0,0)}30%,50%,70%{transform:translate3d(-7px,0,0)}40%,60%{transform:translate3d(7px,0,0)}}
        .touch-control{display:none}
        @media(pointer:coarse){.touch-control{display:flex}}
    </style>
</head>
<body class="text-white">
