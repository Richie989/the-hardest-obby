    <canvas id="gameCanvas"></canvas>

    <div class="absolute inset-0 pointer-events-none p-3 md:p-6 flex flex-col justify-between z-10">
        <div class="flex items-center justify-between gap-2 w-full">
            <div class="flex items-center gap-3 bg-slate-900/90 border-2 border-red-600/80 p-2.5 px-4 rounded-2xl backdrop-blur-md pointer-events-auto shadow-lg">
